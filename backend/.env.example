# Copy to .env and fill in. Never commit .env -- it is gitignored.

# --- Database -----------------------------------------------------------
# Create the role and database first:
#   sudo -u postgres createuser --pwprompt cognito_app
#   sudo -u postgres createdb -O cognito_app cognito_auth
DATABASE_URL=postgresql+psycopg://cognito_app:your_password@localhost:5432/cognito_auth
DB_ECHO=false

# --- AWS ----------------------------------------------------------------
AWS_REGION=ap-southeast-1
# Leave the two keys blank to use ~/.aws/credentials, real environment
# variables, or the IAM role attached to the runtime (this is what you want in
# Lambda -- no secret is deployed).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed when the credentials live under a named profile.
AWS_PROFILE=

# --- Cognito ------------------------------------------------------------
# The app client must allow CUSTOM_AUTH, have a client secret, issue refresh
# tokens, and have the custom-auth Lambda triggers attached to the pool.
COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxxx
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# --- Sessions and cookies ----------------------------------------------
LOGIN_LINK_TTL_SECONDS=600
# Must not exceed the app client's refresh token validity.
REFRESH_TOKEN_TTL_DAYS=30
# Set true wherever the site is served over HTTPS. False only works on
# http://localhost.
COOKIE_SECURE=false
# "lax" is fine while the frontend and API share a site (localhost:3000 and
# localhost:8000 do). Across different domains this must be "none", which also
# requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- Email --------------------------------------------------------------
ENABLE_EMAIL=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Gmail needs a 16-character App Password, not your account password.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

FRONTEND_URL=http://localhost:3000
